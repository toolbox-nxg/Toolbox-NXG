{
    "extends": "@tsconfig/recommended/tsconfig.json",
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",

        // tsc only type-checks; Rollup emits through oxc, which compiles one file at a time without
        // type information. isolatedModules makes tsc reject code that per-file compilation can't
        // handle (const enums across files, re-exported types without `export type`, ...).
        "noEmit": true,
        "isolatedModules": true,

        // Strictness ratchet: these pass today; do not relax.
        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "exactOptionalPropertyTypes": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["extension/**/*"],
    "exclude": ["extension/**/*.test.ts", "extension/**/*.test.tsx"]
}
